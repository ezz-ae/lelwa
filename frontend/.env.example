# ── Lelwa backend (FastAPI / main.py) base URL ───────────────────────────────
# Server-side route handlers (app/api/**) prefer LELWA_API_BASE_URL.
# The browser (client components) uses NEXT_PUBLIC_API_BASE_URL.
# In production set BOTH to your deployed backend URL, e.g. https://lelwa-api.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
LELWA_API_BASE_URL=http://localhost:8000

# ── Dubay AI — Vertex AI (Gemini) ─────────────────────────────────────────────
# Powers the Ask bar (/api/ask) and the console chat (/api/console/chat).
# SAME setup as Freehold — copy the identical value across both projects. The
# service-account JSON is read server-side only and never sent to the browser;
# the project id is derived from it. Paste the JSON as a single line.
VERTEX_AI_SERVICE_ACCOUNT_JSON=
# Optional faster path instead of the service account:
# VERTEX_AI_API_KEY=
# Optional overrides:
# VERTEX_LOCATION=us-central1
# DUBAY_MODEL=gemini-2.5-flash

# ── Entrestate data (grounds Dubay's answers in real Dubai figures) ──────────
# Neon Postgres — the SAME Entrestate DB the backend uses. Read-only here.
# If unset, Dubay still answers (general knowledge), just without live figures.
DATABASE_URL=
