# ── Lelwa backend (FastAPI / main.py) base URL ───────────────────────────────
# Server-side route handlers (app/api/**) prefer LELWA_API_BASE_URL.
# The browser (client components) uses NEXT_PUBLIC_API_BASE_URL.
# In production set BOTH to your deployed backend URL, e.g. https://lelwa-api.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
LELWA_API_BASE_URL=http://localhost:8000

# ── Vertex AI marketing agent (marketing-agency-24119) ───────────────────────
# Powers the "Ask anything about Lelwa" bar via the server-side /api/ask route.
# The service-account JSON is read server-side only and never sent to the browser.
# Create a service account in the project with the "Vertex AI User" role, download
# a JSON key, and paste it here as a single line (or leave blank to use ADC).
GOOGLE_SERVICE_ACCOUNT_JSON=
VERTEX_PROJECT_ID=610006155413
VERTEX_LOCATION=us-central1
VERTEX_REASONING_ENGINE_ID=2989271399492747264
# The field your agent expects inside `input` — "input" or "message" (see Test tab).
VERTEX_INPUT_KEY=input

# ── Agent network (multiple agents) ──────────────────────────────────────────
# Register the whole network as one-line JSON. Each entry: key, label, engineId
# (project/location optional, default to VERTEX_PROJECT_ID / VERTEX_LOCATION).
# If unset, the single VERTEX_REASONING_ENGINE_ID above is used as the "marketing" agent.
# VERTEX_AGENTS=[{"key":"marketing","label":"Marketing","role":"runs & explores ads","engineId":"2989271399492747264"},{"key":"lead","label":"Lead reply","engineId":"<engine-id>"}]
VERTEX_AGENTS=
# Which agent the console / Ask bar use by default (defaults to the first).
VERTEX_DEFAULT_AGENT=marketing
